# ── Servidor ──────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL del frontend (CORS y enlaces en los correos)
CLIENT_URL=http://localhost:5173

# ── Base de datos (PostgreSQL en Neon: neon.tech → Connect) ──────
# Con pooling (la app):
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Directa, sin "-pooler" (prisma db push):
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Seguridad ─────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d
RESET_CODE_TTL_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5

# ── Correo (SMTP) ─────────────────────────────────────
# Si SMTP_HOST está vacío se usa una cuenta de prueba de Ethereal y
# se imprime en consola el enlace para ver el correo.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HANGAR Estudio <no-reply@hangar.studio>"
# En producción (Render bloquea SMTP en el plan gratis): API de Brevo.
# El correo de MAIL_FROM debe estar verificado en Brevo como remitente.
BREVO_API_KEY=

# ── Fotos (Cloudinary → Dashboard → API environment variable) ──
# Vacío = se guardan en Backend/uploads (solo para desarrollo local)
CLOUDINARY_URL=

# ── Asistente de la página ──────────────────────────
# Con clave: responde Claude (console.anthropic.com → API Keys). Vacío: preguntas frecuentes (gratis).
ANTHROPIC_API_KEY=
# A dónde llegan los avisos de "Hablar con una persona"
SUPPORT_EMAIL=juanesteban9283@gmail.com
SUPPORT_PHONE=573161499556
# WhatsApp gratis con CallMeBot: envía "I allow callmebot to send me messages" al +34 644 71 81 99
# por WhatsApp; te responde con tu apikey.
CALLMEBOT_APIKEY=

# ── Administrador inicial (lo crea el seed) ───────────
ADMIN_EMAIL=admin@hangar.studio
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador HANGAR
